#!/bin/bash
# Shell wrapper for the unhealthy worker test fixture.
# The Elixir adapter uses spawn_executable, which needs a real executable.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
WORKER_ROOT="$(cd "${SCRIPT_DIR}/../../../.." && pwd)"
exec uv run --directory "${WORKER_ROOT}/native/orchard_worker_mlx" \
  python "${SCRIPT_DIR}/unhealthy_worker.py" "$@"
