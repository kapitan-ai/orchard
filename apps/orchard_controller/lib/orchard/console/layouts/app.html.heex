<.flash_group flash={@flash} />

<div id="console-app" class="flex flex-col h-[calc(100vh-3px)]">
  <%!-- Connection banner — hidden by default, shown via CSS when disconnected after first connect --%>
  <div
    id="console-connection-banner"
    class="console-connection-banner"
    role="status"
    aria-live="polite"
  >
    <.icon name="hero-bars-3" class="h-4 w-4 flex-shrink-0" />
    <span>Live connection lost — reconnecting. Displayed data may be stale.</span>
  </div>

  <div id="console-shell" class="flex flex-1 min-h-0">
  <%!-- Sidebar --%>
  <aside
    id="console-sidebar"
    class="flex flex-col overflow-hidden bg-slate-100 border-r border-slate-200 dark:bg-slate-800 dark:border-slate-700"
  >
    <%!-- Logo lockup --%>
    <div class="flex items-center h-16 px-4 border-b border-slate-200 dark:border-slate-700 flex-shrink-0">
      <.logo size={:md} />
    </div>

    <%!-- Navigation --%>
    <.sidebar_nav active={assigns[:active_nav] || :overview} />

    <%!-- Sidebar footer: license + version + collapse toggle --%>
    <div class="p-3 border-t border-slate-200 dark:border-slate-700 flex-shrink-0">
      <div
        :if={OrchardConsole.LicenseStatus.visible?(@license_status)}
        id="console-license-badge"
        class="mb-3 rounded-lg border border-slate-200 bg-slate-50 p-2 text-center dark:border-slate-700 dark:bg-slate-900/60"
        role="status"
      >
        <.badge tone={OrchardConsole.LicenseStatus.badge_tone(@license_status)}>
          {OrchardConsole.LicenseStatus.badge_label(@license_status)}
        </.badge>
        <p
          :if={!OrchardConsole.LicenseStatus.valid?(@license_status)}
          class="mt-1 text-xs leading-4 text-amber-700 dark:text-amber-300"
        >
          {@license_status.activation_guidance}
        </p>
      </div>
      <div id="console-sidebar-version" class="console-sidebar-version mb-2 text-center">
        <span class="sidebar-label text-xs text-slate-400 font-mono">
          {OrchardConsole.display_version()}
        </span>
      </div>
      <.theme_toggle class="mb-3 w-full justify-center" />
      <button
        id="sidebar-toggle"
        phx-click={toggle_sidebar()}
        aria-label="Toggle sidebar"
        class="flex items-center justify-center w-full rounded-md p-2 text-slate-400 transition-colors hover:bg-white hover:text-slate-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-navy/40 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-100 dark:hover:bg-slate-700/60 dark:hover:text-slate-300 dark:focus-visible:ring-sky-400/40 dark:focus-visible:ring-offset-slate-800"
      >
        <.icon name="hero-chevron-double-left" class="h-5 w-5 sidebar-toggle-icon" />
      </button>
    </div>
  </aside>

  <%!-- Main content area --%>
  <main class="min-w-0 flex-1 overflow-x-hidden overflow-y-auto bg-slate-50 dark:bg-slate-900">
    <%!-- Page header --%>
    <header
      :if={assigns[:page_title]}
      class="border-b border-slate-200 bg-white px-6 py-4 dark:border-slate-700 dark:bg-slate-800"
    >
      <h1 class={page_title_class(assigns[:page_mode] || :standard)}>
        {assigns[:page_title]}
      </h1>
    </header>

    <%!-- Page content --%>
    <div class={page_content_class(assigns[:page_mode] || :standard)}>
      {@inner_content}
    </div>
  </main>
</div>
</div>
