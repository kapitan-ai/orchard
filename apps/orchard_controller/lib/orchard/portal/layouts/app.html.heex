<.flash_group flash={@flash} />

<div id="portal-app" class="min-h-[calc(100vh-3px)]">
  <header
    :if={assigns[:current_tenant]}
    class="border-b border-slate-700 bg-slate-800"
  >
    <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-3">
      <.logo variant={:lockup} size={:md} />
      <div class="flex items-center gap-4">
        <span class="font-mono text-sm text-slate-300">{@organization_slug}</span>
        <form
          action={"/portal/#{@organization_slug}/logout"}
          method="post"
        >
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <button
            type="submit"
            class="text-sm text-slate-300 transition-colors hover:text-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400/40"
          >
            Sign out
          </button>
        </form>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-3xl px-4 py-10">
    {@inner_content}
  </main>
</div>
