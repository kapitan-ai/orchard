<!DOCTYPE html>
<html lang="en" class="h-full" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="robots" content="noindex,nofollow" />
    <title>
      <%= if assigns[:page_title], do: "#{assigns[:page_title]} — Orchard", else: "Orchard" %>
    </title>
    <link rel="icon" type="image/svg+xml" href={~p"/images/orchard-mark.svg"} />
    <link rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="min-h-full bg-slate-900 text-slate-50 antialiased">
    <div id="brand-bar" class="brand-bar h-[3px]"></div>
    {@inner_content}
  </body>
</html>
