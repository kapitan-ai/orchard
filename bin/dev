#!/usr/bin/env bash
set -euo pipefail

# bin/dev — Idempotent dev environment startup for Orchard.
# Creates/migrates the dev DB, sets the dev gRPC port, starts the Phoenix server.
# Safe to run repeatedly. Works alongside the packaged production BEAM on 50061.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

# Preflight
[[ -f mix.exs ]] || { echo "error: mix.exs not found in $REPO_ROOT" >&2; exit 1; }
command -v mix >/dev/null || { echo "error: mix not found on PATH" >&2; exit 1; }

export MIX_ENV=dev

# ---------------------------------------------------------------------------
# Resolve dev runtime port (default 50071, avoids packaged BEAM on 50061).
# Supports both env var names for parity with config/runtime.exs.
# config/dev.exs has a matching mismatch guard, but we normalize here first
# so the error surfaces before Mix boots.
# ---------------------------------------------------------------------------
node_port="${ORCHARD_NODE_AGENT_LISTEN_PORT:-}"
client_port="${ORCHARD_RUNTIME_CLIENT_PORT:-}"

if [[ -z "$node_port" && -z "$client_port" ]]; then
  resolved_port=50071
elif [[ -n "$node_port" && -z "$client_port" ]]; then
  resolved_port="$node_port"
elif [[ -z "$node_port" && -n "$client_port" ]]; then
  resolved_port="$client_port"
elif [[ "$node_port" == "$client_port" ]]; then
  resolved_port="$node_port"
else
  echo "error: port mismatch — ORCHARD_NODE_AGENT_LISTEN_PORT=$node_port vs ORCHARD_RUNTIME_CLIENT_PORT=$client_port" >&2
  exit 1
fi

export ORCHARD_NODE_AGENT_LISTEN_PORT="$resolved_port"
export ORCHARD_RUNTIME_CLIENT_PORT="$resolved_port"

# ---------------------------------------------------------------------------
# Bootstrap dev database
# ---------------------------------------------------------------------------
echo "==> Ensuring dev database..."
mix ecto.create --quiet
mix ecto.migrate --quiet

# ---------------------------------------------------------------------------
# Start the dev server
# ---------------------------------------------------------------------------
echo "==> Starting dev server (HTTP :${PORT:-4000}, gRPC :${resolved_port})..."
exec iex -S mix phx.server
