[Unit]
Description=Orchard source-development exclusive database migration gate
Requires=orchard-postgresql.service
After=orchard-postgresql.service
ConditionPathExists=/etc/orchard/source-dev/activation-authorized.json

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/orchard/postgresql/lifecycle.env
WorkingDirectory=/opt/orchard/source
ExecStart=/opt/orchard/source/bin/orchard-source-postgresql migrate
Slice=orchard-lifecycle.slice
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/orchard/install
