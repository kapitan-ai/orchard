{
  "schema_version": 1,
  "profile": "ubuntu_24_04_x86_64_single_host",
  "architecture": "amd64",
  "postgresql": {
    "major": 16,
    "packages": [
      {"name": "postgresql-16", "version": "16.15-0ubuntu0.24.04.1"},
      {"name": "postgresql-client-16", "version": "16.15-0ubuntu0.24.04.1"},
      {"name": "postgresql-common", "version": "257build1.1"},
      {"name": "ssl-cert", "version": "1.1.2ubuntu1"}
    ],
    "closure_path": "packaging/linux/appliance/postgresql-16-closure.json",
    "install_policy": "source_lifecycle_owned_no_automatic_cluster",
    "socket": "/run/postgresql/.s.PGSQL.5432",
