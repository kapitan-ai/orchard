      "expected": {"final_text": "plain answer", "failure_code": null, "failure_reason": null},
      "coverage": ["policy:disabled", "no_marker", "terminal:completed"]
    },
    {
      "id": "tagged-pair-enabled-accepts-unicode-split-markers",
