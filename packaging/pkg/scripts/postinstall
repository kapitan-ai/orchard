#!/bin/sh
set -eu
# Orchard PKG postinstall — install wrappers/plists, resolve role-scoped TLS state,
# validate controller TLS when configured, and finish install markers.
#
# SPEC.md §11.4: postinstall creation of launchd plists,
# optional controller-only or node-only modes.
#
# Flow (Sub-tasks 2–4 of Task 4):
#   1. Remove unsupported managed Postgres launchd plist
#   2. Resolve install role from request/marker/default
#   3. Install wrapper binaries
#   4. Install wrapper symlinks into /usr/local/bin
#   5. Defer role-selected launchd plist mutation until TLS validation passes
#   6. Normalize directory ownership/permissions
#   7. Read install context marker (diagnostic)
#   8. Securely source controller.env if valid
#   9. Resolve controller TLS mode and act for controller-bearing roles
#   10. Install/remove role-selected controller/node-agent launchd plists
#   11. Write role/completion markers and clean up context marker

ORCHARD_ROOT="/Library/Application Support/Orchard"
LAUNCHD_SRC="$ORCHARD_ROOT/share/launchd"
TLS_DIR="$ORCHARD_ROOT/config/tls"
PUBLIC_DIR="$ORCHARD_ROOT/public"
ENDPOINT_METADATA_FILE="$PUBLIC_DIR/endpoint.json"
INSTALL_ROLE_REQUEST_FILE="$ORCHARD_ROOT/support/.install-role.request"
INSTALL_ROLE_FILE="$ORCHARD_ROOT/support/.install-role"

# ===========================================================================
# Helper functions
# ===========================================================================

# is_truthy VALUE — returns 0 (true), 1 (false), or 2 (invalid).
# Matches config/runtime.exs env_bool semantics exactly.
# Callers must pass the raw value; empty string is invalid (runtime.exs raises).
is_truthy() {
  case "$1" in
    1|true|TRUE|yes|YES|on|ON)      return 0 ;;
    0|false|FALSE|no|NO|off|OFF)    return 1 ;;
    *)                               return 2 ;;
  esac
}

# secure_source_env FILE — sources FILE only if root-owned with no
# group/world permission bits. Mirrors orchard-controller wrapper logic.
secure_source_env() {
  _ssf="$1"
  if [ ! -f "$_ssf" ]; then
    return 0  # absent is fine — no overrides
  fi
  _meta=$(stat -f '%u:%Lp' "$_ssf" 2>/dev/null) || _meta=""
  _uid=${_meta%%:*}
  _mode=${_meta#*:}
  if [ -z "$_meta" ]; then
    printf 'postinstall: ERROR: could not inspect env file %s; refusing to normalize an untrusted env file\n' "$_ssf" >&2
    return 2
  fi
  if [ "$_uid" != "0" ]; then
    printf 'postinstall: ERROR: env file %s must be root-owned before postinstall will trust or normalize it (owner uid=%s)\n' "$_ssf" "$_uid" >&2
    return 2
  fi
  if [ "${_mode#?}" != "00" ]; then
    printf 'postinstall: ERROR: env file %s must not have group/world permission bits before postinstall will trust or normalize it (mode=%s)\n' "$_ssf" "$_mode" >&2
    return 2
  fi
  set -a
  # shellcheck source=/dev/null
  . "$_ssf"
  set +a
}

normalize_console_env_if_trusted() {
  _console_env="$ORCHARD_ROOT/config/console.env"
  if [ ! -f "$_console_env" ]; then
    return 0
  fi

  _meta=$(stat -f '%u:%Lp' "$_console_env" 2>/dev/null) || _meta=""
  _uid=${_meta%%:*}
  _mode=${_meta#*:}
  if [ -z "$_meta" ]; then
    printf 'postinstall: WARNING: leaving untrusted console env file unchanged; could not inspect %s\n' "$_console_env" >&2
    printf 'postinstall: Move it aside and recreate with sudo orchardctl console enable.\n' >&2
    return 0
  fi
  if [ "$_uid" != "0" ]; then
    printf 'postinstall: WARNING: leaving untrusted console env file unchanged; %s must be root-owned before postinstall will trust or normalize it (owner uid=%s)\n' "$_console_env" "$_uid" >&2
    printf 'postinstall: Move it aside and recreate with sudo orchardctl console enable.\n' >&2
    return 0
  fi
  if [ "${_mode#?}" != "00" ]; then
    printf 'postinstall: WARNING: leaving untrusted console env file unchanged; %s must not have group/world permission bits before postinstall will trust or normalize it (mode=%s)\n' "$_console_env" "$_mode" >&2
    printf 'postinstall: Move it aside and recreate with sudo orchardctl console enable.\n' >&2
    return 0
  fi

  chown root:wheel "$_console_env" 2>/dev/null || true
  chmod 0600 "$_console_env"
}

# resolve_tls_mode — prints one of:
#   disabled  managed_default  external_override  invalid_override  invalid_boolean
#   invalid_transport  transport_reverse_proxy  transport_plain_http_localhost
# Uses ORCHARD_TRANSPORT_MODE, ORCHARD_TLS_DISABLED, ORCHARD_TLS_CERTFILE, ORCHARD_TLS_KEYFILE.
resolve_tls_mode() {
  # Validate legacy booleans first, but do not let them override an explicit
  # ORCHARD_TRANSPORT_MODE. Invalid booleans remain structurally invalid.
  _legacy_disabled_set=false
  _legacy_disabled=false
  if [ -n "${ORCHARD_TLS_DISABLED+x}" ]; then
    _legacy_disabled_set=true
    _is_rc=0
    is_truthy "$ORCHARD_TLS_DISABLED" || _is_rc=$?
    if [ "$_is_rc" -eq 0 ]; then
      _legacy_disabled=true
    elif [ "$_is_rc" -eq 2 ]; then
      printf 'invalid_boolean'
      return 0
    fi
  fi

  # Validate legacy cert/key structure before applying transport precedence.
  _cert_set=false
  _key_set=false
  if [ -n "${ORCHARD_TLS_CERTFILE+x}" ]; then _cert_set=true; fi
  if [ -n "${ORCHARD_TLS_KEYFILE+x}" ]; then _key_set=true; fi

  if [ "$_cert_set" != "$_key_set" ]; then
    printf 'invalid_override'
    return 0
  fi

  if [ "$_cert_set" = true ] && { [ -z "$ORCHARD_TLS_CERTFILE" ] || [ -z "$ORCHARD_TLS_KEYFILE" ]; }; then
    printf 'invalid_override'
    return 0
  fi

  if [ -n "${ORCHARD_TLS_CACERTFILE+x}" ] && [ -z "$ORCHARD_TLS_CACERTFILE" ]; then
    printf 'invalid_ca_override'
    return 0
  fi

  # ORCHARD_TRANSPORT_MODE is authoritative when present.
  if [ -n "${ORCHARD_TRANSPORT_MODE+x}" ]; then
    case "$ORCHARD_TRANSPORT_MODE" in
      reverse_proxy)
        printf 'transport_reverse_proxy'
        return 0
        ;;
      plain_http_localhost)
        printf 'transport_plain_http_localhost'
        return 0
        ;;
      direct_https)
        if [ "$_cert_set" = true ]; then
          printf 'external_override'
        else
          printf 'managed_default'
        fi
        return 0
        ;;
      *)
        printf 'invalid_transport'
        return 0
        ;;
    esac
  fi

  # Legacy compatibility when the new transport mode is unset.
  if [ "$_legacy_disabled" = true ]; then
    printf 'disabled'
    return 0
  fi

  if [ "$_legacy_disabled_set" = true ]; then
    printf 'managed_default'
    return 0
  fi

  if [ "$_cert_set" = true ]; then
    printf 'external_override'
    return 0
  fi

  printf 'transport_plain_http_localhost'
}

# inspect_managed_tls_state — prints: empty | complete | partial
inspect_managed_tls_state() {
  _found=0
  _expected=4
  for _f in "$TLS_DIR/ca.key" "$TLS_DIR/ca.crt" \
            "$TLS_DIR/controller.key" "$TLS_DIR/controller.crt"; do
    if [ -f "$_f" ]; then
      _found=$(( _found + 1 ))
    elif [ -e "$_f" ] || [ -L "$_f" ]; then
      # Exists but is not a regular file (directory, broken symlink, etc.)
      printf 'partial'
      return 0
    fi
  done
  if [ "$_found" -eq 0 ]; then
    printf 'empty'
  elif [ "$_found" -eq "$_expected" ]; then
    printf 'complete'
  else
    printf 'partial'
  fi
}

# require_regular_file VAR_NAME PATH — aborts with message if missing/non-regular.
require_regular_file() {
  _var="$1"
  _path="$2"
  if [ ! -f "$_path" ]; then
    printf 'postinstall: ERROR: %s=%s is not a regular file or does not exist\n' "$_var" "$_path" >&2
    return 1
  fi
}

json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

json_safe_string() {
  _value="$1"
  _newline='
'
  case "$_value" in
    *"$_newline"*) return 1 ;;
    *[![:print:]]*) return 1 ;;
    *) json_escape "$_value" ;;
  esac
}

json_string_or_null() {
  _value="$1"
  if [ -z "$_value" ]; then
    printf 'null'
  else
    printf '"%s"' "$(json_safe_string "$_value")"
  fi
}

valid_port_value() {
  case "$1" in
    ''|*[!0-9]*) return 1 ;;
    *) [ "$1" -ge 1 ] && [ "$1" -le 65535 ] ;;
  esac
}

json_integer_or_null() {
  _value="$1"
  if [ -z "$_value" ]; then
    printf 'null'
  else
    valid_port_value "$_value"
    printf '%s' "$_value"
  fi
}

valid_json_string_or_empty() {
  _value="$1"
  [ -z "$_value" ] && return 0
  json_safe_string "$_value" >/dev/null
}

valid_endpoint_host() {
  _value="$1"
  [ -z "$_value" ] && return 1
  valid_json_string_or_empty "$_value" || return 1
  case "$_value" in
    *://*|*' '*) return 1 ;;
    *) return 0 ;;
  esac
}

validate_endpoint_metadata_fields() {
  valid_json_string_or_empty "$_transport_mode" || return 1
  valid_endpoint_host "$_public_host" || return 1
  valid_json_string_or_empty "$_api_bind_ip" || return 1
  valid_json_string_or_empty "$_ca_certfile" || return 1
  case "$_transport_mode" in
    direct_https)
      valid_port_value "$_api_https_port" || return 1
      [ -z "$_plain_http_port" ] || valid_port_value "$_plain_http_port" || return 1
      ;;
    reverse_proxy)
      valid_port_value "$_api_https_port" || return 1
      valid_port_value "$_plain_http_port" || return 1
      ;;
    plain_http_localhost)
      [ -z "$_api_https_port" ] || valid_port_value "$_api_https_port" || return 1
      valid_port_value "$_plain_http_port" || return 1
      ;;
    *) return 1 ;;
  esac
}

write_endpoint_metadata() {
  _transport_mode="$1"
  _ca_certfile="$2"
  if [ -n "${ORCHARD_PUBLIC_HOST+x}" ]; then
    _public_host="$ORCHARD_PUBLIC_HOST"
  elif [ -n "${PHX_HOST+x}" ]; then
    _public_host="$PHX_HOST"
  else
    _public_host="localhost"
  fi
  _api_bind_ip="${ORCHARD_API_BIND_IP:-}"
  _api_https_port=""
  _plain_http_port=""

  case "$_transport_mode" in
    direct_https)
      if [ -n "${ORCHARD_API_HTTPS_PORT+x}" ]; then
        _api_https_port="$ORCHARD_API_HTTPS_PORT"
      else
        _api_https_port="8443"
      fi
      ;;
    reverse_proxy)
      if [ -n "${ORCHARD_PUBLIC_PORT+x}" ]; then
        _api_https_port="$ORCHARD_PUBLIC_PORT"
      else
        _api_https_port="443"
      fi
      if [ -n "${PORT+x}" ]; then
        _plain_http_port="$PORT"
      else
        _plain_http_port="4000"
      fi
      ;;
    plain_http_localhost)
      if [ -n "${PORT+x}" ]; then
        _plain_http_port="$PORT"
      else
        _plain_http_port="4000"
      fi
      ;;
    *)
      return 0
      ;;
  esac

  if ! validate_endpoint_metadata_fields; then
    printf 'postinstall: warning: skipping endpoint metadata sidecar; invalid non-secret endpoint metadata\n' >&2
    return 0
  fi

  mkdir -p "$ORCHARD_ROOT" "$PUBLIC_DIR"
  chmod 0755 "$ORCHARD_ROOT" "$PUBLIC_DIR"
  chown root:wheel "$ORCHARD_ROOT" "$PUBLIC_DIR" 2>/dev/null || true

  _tmp="$ENDPOINT_METADATA_FILE.$$.$RANDOM.tmp"
  {
    printf '{\n'
    printf '  "schema_version": 1,\n'
    printf '  "transport_mode": %s,\n' "$(json_string_or_null "$_transport_mode")"
    printf '  "public_host": %s,\n' "$(json_string_or_null "$_public_host")"
    printf '  "api_https_port": %s,\n' "$(json_integer_or_null "$_api_https_port")"
    printf '  "plain_http_port": %s,\n' "$(json_integer_or_null "$_plain_http_port")"
    printf '  "api_bind_ip": %s,\n' "$(json_string_or_null "$_api_bind_ip")"
    printf '  "ca_certfile": %s,\n' "$(json_string_or_null "$_ca_certfile")"
    printf '  "updated_at": "%s",\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    printf '  "generated_by": "postinstall"\n'
    printf '}\n'
  } > "$_tmp"
  chown root:wheel "$_tmp" 2>/dev/null || true
  chmod 0644 "$_tmp"
  mv -f "$_tmp" "$ENDPOINT_METADATA_FILE"
  printf 'postinstall: wrote endpoint metadata sidecar %s\n' "$ENDPOINT_METADATA_FILE"
}

generated_local_ca_metadata_present() {
  [ -f "$TLS_DIR/.orchard-tls-meta.json" ] || return 1
  _source=$(plutil -extract source raw -o - "$TLS_DIR/.orchard-tls-meta.json" 2>/dev/null) || return 1
  [ "$_source" = "generated_local_ca" ]
}

publish_generated_ca_if_available() {
  if [ -n "${ORCHARD_TLS_CERTFILE+x}" ] || [ -n "${ORCHARD_TLS_KEYFILE+x}" ]; then
    printf ''
    return 0
  fi

  if [ ! -f "$TLS_DIR/ca.crt" ] || ! generated_local_ca_metadata_present; then
    printf ''
    return 0
  fi

  mkdir -p "$PUBLIC_DIR"
  chmod 0755 "$PUBLIC_DIR"
  chown root:wheel "$PUBLIC_DIR" 2>/dev/null || true
  cp "$TLS_DIR/ca.crt" "$PUBLIC_DIR/ca.crt"
  chown root:wheel "$PUBLIC_DIR/ca.crt" 2>/dev/null || true
  chmod 0644 "$PUBLIC_DIR/ca.crt"
  printf '%s' "$PUBLIC_DIR/ca.crt"
}

write_endpoint_metadata_for_tls_mode() {
  _tls_mode="$1"

  case "$_tls_mode" in
    transport_plain_http_localhost|disabled)
      write_endpoint_metadata "plain_http_localhost" ""
      ;;
    transport_reverse_proxy)
      write_endpoint_metadata "reverse_proxy" ""
      ;;
    managed_default)
      _tls_state=$(inspect_managed_tls_state)
      if [ "$_tls_state" = "complete" ]; then
        _public_ca=$(publish_generated_ca_if_available)
        write_endpoint_metadata "direct_https" "$_public_ca"
      fi
      ;;
    external_override)
      write_endpoint_metadata "direct_https" ""
      ;;
    *)
      return 0
      ;;
  esac
}

validate_install_role() {
  case "$1" in
    all|controller|node-agent) return 0 ;;
    *) return 1 ;;
  esac
}

read_install_role_file() {
  _role_path="$1"
  _role_kind="$2"

  _role_raw=$( (cat "$_role_path" && printf '.') 2>/dev/null) || {
    printf 'postinstall: ERROR: could not read %s install role file: %s\n' \
      "$_role_kind" "$_role_path" >&2
    return 1
  }
  _role_raw=${_role_raw%.}

  _newline='
'
  case "$_role_raw" in
    all|controller|node-agent)
      printf '%s' "$_role_raw"
      return 0
      ;;
    all"$_newline"|controller"$_newline"|node-agent"$_newline")
      printf '%s' "${_role_raw%"$_newline"}"
      return 0
      ;;
    *)
      printf 'postinstall: ERROR: invalid %s install role in %s: %s\n' \
        "$_role_kind" "$_role_path" "$_role_raw" >&2
      printf 'postinstall: Accepted install roles: all, controller, node-agent\n' >&2
      printf 'postinstall: To change role, write one accepted value to %s and rerun installer.\n' \
        "$INSTALL_ROLE_REQUEST_FILE" >&2
      return 1
      ;;
  esac
}

validate_install_role_request_file() {
  _request_path="$1"
  _meta=$(stat -f '%u:%Lp' "$_request_path" 2>/dev/null) || {
    printf 'postinstall: ERROR: could not inspect request install role file: %s\n' \
      "$_request_path" >&2
    return 1
  }

  _uid=${_meta%%:*}
  _mode=${_meta#*:}

  if [ "$_uid" != "0" ]; then
    printf 'postinstall: ERROR: request install role file %s must be root-owned (uid=0), found uid=%s\n' \
      "$_request_path" "$_uid" >&2
    printf 'postinstall: Fix with: chown root:wheel %s\n' "$_request_path" >&2
    return 1
  fi

  _group_digit=$(printf '%s' "$_mode" | sed 's/.*\(.\).$/\1/')
  _world_digit=$(printf '%s' "$_mode" | sed 's/.*\(.\)$/\1/')

  case "$_group_digit" in
    2|3|6|7)
      printf 'postinstall: ERROR: request install role file %s must not be group/world writable (mode=%s)\n' \
        "$_request_path" "$_mode" >&2
      printf 'postinstall: Fix with: chmod 0600 %s\n' "$_request_path" >&2
      return 1
      ;;
  esac

  case "$_world_digit" in
    2|3|6|7)
      printf 'postinstall: ERROR: request install role file %s must not be group/world writable (mode=%s)\n' \
        "$_request_path" "$_mode" >&2
      printf 'postinstall: Fix with: chmod 0600 %s\n' "$_request_path" >&2
      return 1
      ;;
  esac
}

role_includes_service() {
  _role_service="$1"

  case "$install_role:$_role_service" in
    all:com.orchard.controller|all:com.orchard.node-agent|\
controller:com.orchard.controller|\
node-agent:com.orchard.node-agent)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

remove_out_of_role_plist() {
  _role_label="$1"
  _role_target="/Library/LaunchDaemons/$_role_label.plist"

  launchctl bootout system/"$_role_label" >/dev/null 2>&1 || true

  if [ -e "$_role_target" ] || [ -L "$_role_target" ]; then
    printf 'postinstall: removing out-of-role LaunchDaemon %s\n' "$_role_label"
    rm -f "$_role_target"
  fi
}

remove_unsupported_managed_postgres_plist() {
  _postgres_label="com.orchard.postgres"
  _postgres_target="/Library/LaunchDaemons/$_postgres_label.plist"

  launchctl bootout system/"$_postgres_label" >/dev/null 2>&1 || true

  if [ -e "$_postgres_target" ] || [ -L "$_postgres_target" ]; then
    printf 'postinstall: removing unsupported managed Postgres LaunchDaemon %s\n' \
      "$_postgres_label"
    rm -f "$_postgres_target"
  fi
}

# ===========================================================================
# 1. Remove unsupported managed Postgres launchd plist
# ===========================================================================
remove_unsupported_managed_postgres_plist

# ===========================================================================
# 2. Resolve install role
# ===========================================================================
if [ -f "$INSTALL_ROLE_REQUEST_FILE" ]; then
  validate_install_role_request_file "$INSTALL_ROLE_REQUEST_FILE" || exit 1
  install_role=$(read_install_role_file "$INSTALL_ROLE_REQUEST_FILE" requested) || exit 1
  install_role_source="request"
elif [ -f "$INSTALL_ROLE_FILE" ]; then
  install_role=$(read_install_role_file "$INSTALL_ROLE_FILE" existing) || exit 1
  install_role_source="marker"
else
  install_role="all"
  install_role_source="default"
fi

validate_install_role "$install_role" || {
  printf 'postinstall: ERROR: resolved invalid install role: %s\n' "$install_role" >&2
  printf 'postinstall: Accepted install roles: all, controller, node-agent\n' >&2
  exit 1
}
printf 'postinstall: install_role=%s source=%s\n' "$install_role" "$install_role_source"

# ===========================================================================
# 3. Install wrapper commands into bin/
# ===========================================================================
for cmd in orchard-controller orchard-node-agent orchardctl orchard-managed-postgres; do
  src="$ORCHARD_ROOT/share/bin/$cmd"
  dst="$ORCHARD_ROOT/bin/$cmd"
  if [ -f "$src" ]; then
    install -m 0755 "$src" "$dst"
  fi
done

# ===========================================================================
# 4. Symlink wrappers into PATH (/usr/local/bin)
# ===========================================================================
# Note: Symlinks are created conditionally to support controller-only or
# node-only install modes (SPEC.md §11.4). Missing binaries are skipped
# without error as they may be intentionally absent in partial installs.
mkdir -p /usr/local/bin
for cmd in orchardctl orchard-controller orchard-node-agent; do
  src="$ORCHARD_ROOT/bin/$cmd"
  if [ -x "$src" ]; then
    ln -sf "$src" "/usr/local/bin/$cmd"
  else
    printf 'postinstall: INFO: skipping PATH symlink for %s (not present - optional install mode)\n' "$cmd" >&2
  fi
done

# ===========================================================================
# 5. Install role-selected launchd plists is deferred until TLS validation
# ===========================================================================

# ===========================================================================
# 6. Normalize directory ownership and permissions
# ===========================================================================
# Targeted hardening — do NOT recursive-chown before env inspection, as that
# would mask insecure controller.env ownership.
chown root:wheel "$ORCHARD_ROOT"
chmod 0755 "$ORCHARD_ROOT"
chown root:wheel "$ORCHARD_ROOT/bin" "$ORCHARD_ROOT/support"
chown root:admin "$ORCHARD_ROOT/config" "$ORCHARD_ROOT/config/tls"
chown root:wheel "$ORCHARD_ROOT/logs"
# 0750 grants admin-group traversal/read while keeping access restricted.
chmod 0750 "$ORCHARD_ROOT/config"
chmod 0750 "$ORCHARD_ROOT/config/tls"
chmod 0755 "$ORCHARD_ROOT/logs"

# ===========================================================================
# 7. Read install context marker (diagnostic)
# ===========================================================================
install_mode="unknown"
install_reason="unknown"
context_file="$ORCHARD_ROOT/support/.pkg-install-context"
if [ -f "$context_file" ]; then
  # Parse key=value lines
  while IFS='=' read -r _key _val; do
    case "$_key" in
      mode)   install_mode="$_val" ;;
      reason) install_reason="$_val" ;;
    esac
  done < "$context_file"
else
  printf 'postinstall: WARNING: install context marker not found; proceeding anyway\n' >&2
fi
printf 'postinstall: install_mode=%s reason=%s\n' "$install_mode" "$install_reason"

# ===========================================================================
# 8. Securely source controller.env if valid (controller-bearing roles only)
# ===========================================================================
if [ "$install_role" = "node-agent" ]; then
  printf 'postinstall: node-agent role selected; skipping controller.env load\n'
else
  secure_source_env "$ORCHARD_ROOT/config/controller.env" || exit 1
fi

# Keep env files owner-only (0600) for security - secrets inside.
# orchardctl sources controller.env for DB-backed commands when run with suitable privileges.
for env_file in "$ORCHARD_ROOT/config/controller.env" "$ORCHARD_ROOT/config/node-agent.env"; do
  if [ -f "$env_file" ]; then
    chown root:wheel "$env_file"
    chmod 0600 "$env_file"
  fi
done
normalize_console_env_if_trusted

# ===========================================================================
# 9. Resolve controller TLS mode and act for controller-bearing roles
# ===========================================================================
if [ "$install_role" = "node-agent" ]; then
  printf 'postinstall: node-agent role selected; skipping controller TLS setup\n'
else
  tls_mode=$(resolve_tls_mode)
  printf 'postinstall: tls_mode=%s\n' "$tls_mode"

  if [ -n "${ORCHARD_TRANSPORT_MODE+x}" ]; then
    legacy_conflict=false
    if [ -n "${ORCHARD_TLS_DISABLED+x}" ]; then
      _lt_rc=0
      is_truthy "$ORCHARD_TLS_DISABLED" || _lt_rc=$?
      if { [ "$_lt_rc" -eq 0 ] && [ "$ORCHARD_TRANSPORT_MODE" != "plain_http_localhost" ]; } || \
         { [ "$_lt_rc" -eq 1 ] && [ "$ORCHARD_TRANSPORT_MODE" = "plain_http_localhost" ]; }; then
        legacy_conflict=true
      fi
    fi
    if [ -n "${ORCHARD_TLS_CERTFILE+x}" ] && [ "$ORCHARD_TRANSPORT_MODE" != "direct_https" ]; then
      legacy_conflict=true
    fi
    if [ "$legacy_conflict" = "true" ]; then
      printf 'postinstall: WARNING: ORCHARD_TRANSPORT_MODE=%s is authoritative; conflicting legacy TLS envs are deprecated and ignored when inconsistent; new transport mode wins\n' "$ORCHARD_TRANSPORT_MODE" >&2
    fi
  fi

  case "$tls_mode" in
    invalid_boolean)
      printf 'postinstall: ERROR: ORCHARD_TLS_DISABLED has invalid value: %s\n' \
        "${ORCHARD_TLS_DISABLED:-}" >&2
      printf 'postinstall: Accepted values: 1,true,TRUE,yes,YES,on,ON,0,false,FALSE,no,NO,off,OFF\n' >&2
      exit 1
      ;;

    invalid_override)
      printf 'postinstall: ERROR: ORCHARD_TLS_CERTFILE and ORCHARD_TLS_KEYFILE must both be set (non-empty) or both unset\n' >&2
      printf 'postinstall:   ORCHARD_TLS_CERTFILE=%s\n' "${ORCHARD_TLS_CERTFILE:-<unset>}" >&2
      printf 'postinstall:   ORCHARD_TLS_KEYFILE=%s\n' "${ORCHARD_TLS_KEYFILE:-<unset>}" >&2
      exit 1
      ;;

    invalid_ca_override)
      printf 'postinstall: ERROR: ORCHARD_TLS_CACERTFILE must not be empty\n' >&2
      exit 1
      ;;

    invalid_transport)
      printf 'postinstall: ERROR: ORCHARD_TRANSPORT_MODE must be reverse_proxy, direct_https, or plain_http_localhost (got: %s)\n' "${ORCHARD_TRANSPORT_MODE:-}" >&2
      exit 1
      ;;

    transport_reverse_proxy)
      printf 'postinstall: ORCHARD_TRANSPORT_MODE=reverse_proxy; skipping managed TLS inspection for proxy-terminated public HTTPS\n'
      ;;

    transport_plain_http_localhost)
      printf 'postinstall: ORCHARD_TRANSPORT_MODE=plain_http_localhost; skipping managed TLS inspection for local/emergency HTTP\n'
      if [ -z "${ORCHARD_TRANSPORT_MODE+x}" ]; then
        tls_state=$(inspect_managed_tls_state)
        if [ "$tls_state" = "complete" ]; then
          printf 'postinstall: managed TLS files exist but default transport is plain_http_localhost; set ORCHARD_TRANSPORT_MODE=direct_https to use them.\n'
        elif [ "$tls_state" = "partial" ]; then
          printf 'postinstall: WARNING: partial managed TLS files exist but default transport is plain_http_localhost; direct_https will fail until TLS files are repaired.\n' >&2
        fi
      fi
      ;;

    disabled)
      printf 'postinstall: TLS is disabled (ORCHARD_TLS_DISABLED=%s); skipping TLS setup\n' \
        "${ORCHARD_TLS_DISABLED:-}" >&2
      ;;

    managed_default)
      tls_state=$(inspect_managed_tls_state)
      printf 'postinstall: managed TLS state=%s\n' "$tls_state"

      case "$tls_state" in
        empty)
          printf 'postinstall: managed TLS files are not installed; continuing without automatic certificate generation.\n'
          printf 'postinstall: To use operator-provided HTTPS, set ORCHARD_TRANSPORT_MODE=direct_https with ORCHARD_TLS_CERTFILE and ORCHARD_TLS_KEYFILE.\n'
          printf 'postinstall: To create local generated TLS, run sudo orchardctl tls init --no-trust, then set ORCHARD_TRANSPORT_MODE=direct_https.\n'
          printf 'postinstall: For degraded local/emergency HTTP only, set ORCHARD_TRANSPORT_MODE=plain_http_localhost.\n'
          ;;
        complete)
          printf 'postinstall: existing managed TLS certificates found; preserving\n'
          ;;
        partial)
          printf 'postinstall: ERROR: partial managed TLS state in %s\n' "$TLS_DIR" >&2
          printf 'postinstall: Expected all four files: ca.key, ca.crt, controller.key, controller.crt\n' >&2
          printf 'postinstall: Found:\n' >&2
          for _f in ca.key ca.crt controller.key controller.crt; do
            if [ -f "$TLS_DIR/$_f" ]; then
              printf '  [present] %s\n' "$_f" >&2
            else
              printf '  [MISSING] %s\n' "$_f" >&2
            fi
          done
          printf 'postinstall: Remove all TLS files and rerun install, or provide all four files\n' >&2
          exit 1
          ;;
      esac
      ;;

    external_override)
      printf 'postinstall: external TLS override configured; validating files\n'
      require_regular_file "ORCHARD_TLS_CERTFILE" "$ORCHARD_TLS_CERTFILE" || exit 1
      require_regular_file "ORCHARD_TLS_KEYFILE" "$ORCHARD_TLS_KEYFILE" || exit 1
      if [ -n "${ORCHARD_TLS_CACERTFILE+x}" ] && [ -n "${ORCHARD_TLS_CACERTFILE}" ]; then
        require_regular_file "ORCHARD_TLS_CACERTFILE" "$ORCHARD_TLS_CACERTFILE" || exit 1
      fi
      printf 'postinstall: external TLS files validated\n'
      ;;
  esac

  write_endpoint_metadata_for_tls_mode "$tls_mode"
fi

# ===========================================================================
# 10. Install/remove controller/node-agent launchd plists by role
# ===========================================================================

# System daemons: controller + node-agent are payload-universal, but installed
# only when included by the persisted host role.
for svc in com.orchard.controller com.orchard.node-agent; do
  if role_includes_service "$svc"; then
    plist="$LAUNCHD_SRC/$svc.plist"
    if [ -f "$plist" ]; then
      install -m 0644 "$plist" /Library/LaunchDaemons/"$svc".plist
    fi
  else
    remove_out_of_role_plist "$svc"
  fi
done

# Tray user agent: install plist but do not bootstrap (runs per-user on login)
if [ -f "$LAUNCHD_SRC/com.orchard.tray.plist" ]; then
  install -m 0644 "$LAUNCHD_SRC/com.orchard.tray.plist" \
    /Library/LaunchAgents/com.orchard.tray.plist
fi

# ===========================================================================
# 11. Write role/completion markers and clean up
# ===========================================================================
role_tmp="$ORCHARD_ROOT/support/.install-role.tmp"
printf '%s\n' "$install_role" > "$role_tmp"
chown root:wheel "$role_tmp"
chmod 0644 "$role_tmp"
mv -f "$role_tmp" "$INSTALL_ROLE_FILE"

complete_file="$ORCHARD_ROOT/support/.pkg-install-complete"
complete_tmp="$ORCHARD_ROOT/support/.pkg-install-complete.tmp"

printf 'version=1\ncompleted_at=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" > "$complete_tmp"
chmod 0600 "$complete_tmp"
mv -f "$complete_tmp" "$complete_file"

# Remove transient request/context markers only after successful marker writes.
rm -f "$INSTALL_ROLE_REQUEST_FILE"
rm -f "$ORCHARD_ROOT/support/.pkg-install-context"

case "$install_role" in
  all) installed_services="controller and node-agent" ;;
  controller) installed_services="controller" ;;
  node-agent) installed_services="node-agent" ;;
esac

printf 'Orchard installation complete.\n'
printf 'Selected install role: %s.\n' "$install_role"
printf '%s launchd service(s) were installed but not started.\n' "$installed_services"
printf 'Next steps for first-run setup:\n'
printf '1. Provide or verify the Orchard license using the supported license activation path.\n'
printf '2. Run: sudo orchardctl env init\n'
if [ "$install_role" = "node-agent" ]; then
  printf '3. Run: sudo orchardctl start\n'
  printf '4. Verify: orchardctl status\n'
else
  printf '3. Run: sudo orchardctl migrate\n'
  printf '4. Configure transport before start. For local generated HTTPS run: sudo orchardctl transport enable-local-https --host HOST; for reverse proxy or external certificates follow the package README.\n'
  printf '5. Optional Console: sudo orchardctl console enable\n'
  printf '6. Run: sudo orchardctl start\n'
  printf '7. Verify: orchardctl status\n'
fi
exit 0
