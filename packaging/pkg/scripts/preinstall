#!/bin/sh
set -eu
# Orchard PKG preinstall — prepare directories, detect install mode, and stop
# existing services.

ORCHARD_ROOT="/Library/Application Support/Orchard"

# --- 1. Stop existing services if upgrading --------------------------------
# NOTE: if postinstall fails (e.g. TLS validation error), these services
# remain stopped. Recovery: fix the config issue and rerun the installer.
# A future improvement could defer shutdown or re-bootstrap on failure.
for svc in com.orchard.controller com.orchard.node-agent com.orchard.postgres; do
  if launchctl list "$svc" >/dev/null 2>&1; then
    launchctl bootout system/"$svc" 2>/dev/null || true
  fi
done

# Stop tray agent for all console users
for uid in $(ps -Ao uid= -o comm= | grep -i orchard | awk '{print $1}' | sort -u); do
  launchctl bootout gui/"$uid"/com.orchard.tray 2>/dev/null || true
done

# --- 2. Create required directory structure (SPEC.md §11.1) ----------------
for dir in bin config config/tls data models bundles logs support releases; do
  mkdir -p "$ORCHARD_ROOT/$dir"
done

# Harden sensitive directories
chmod 0700 "$ORCHARD_ROOT/config"
chmod 0700 "$ORCHARD_ROOT/config/tls"

# --- 3. Detect install mode (fresh vs upgrade) -----------------------------
# Used by postinstall to decide whether to auto-generate TLS certificates.
#
# Detection order:
#   1. Persistent completion marker from a prior successful install -> upgrade
#   2. Artifact heuristic (launchd plists, release binaries, env, TLS) -> upgrade
#   3. Otherwise -> fresh

install_mode="fresh"
install_reason="none"

if [ -f "$ORCHARD_ROOT/support/.pkg-install-complete" ]; then
  install_mode="upgrade"
  install_reason="completion_marker"
else
  for artifact in \
    /Library/LaunchDaemons/com.orchard.controller.plist \
    /Library/LaunchDaemons/com.orchard.node-agent.plist \
    "$ORCHARD_ROOT/releases/orchard_controller/bin/orchard_controller" \
    "$ORCHARD_ROOT/releases/orchard_node_agent/bin/orchard_node_agent" \
    "$ORCHARD_ROOT/config/controller.env" \
    "$ORCHARD_ROOT/config/tls/ca.crt" \
  ; do
    if [ -e "$artifact" ]; then
      install_mode="upgrade"
      install_reason="artifact_heuristic"
      break
    fi
  done
fi

# --- 4. Write transient install context marker -----------------------------
# Atomic write via temp file + rename.
context_tmp="$ORCHARD_ROOT/support/.pkg-install-context.tmp"
context_file="$ORCHARD_ROOT/support/.pkg-install-context"

printf 'version=1\nmode=%s\nreason=%s\n' "$install_mode" "$install_reason" > "$context_tmp"
chmod 0600 "$context_tmp"
mv -f "$context_tmp" "$context_file"

echo "preinstall: install_mode=$install_mode reason=$install_reason"

exit 0
