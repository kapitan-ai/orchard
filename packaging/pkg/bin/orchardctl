#!/bin/sh
set -eu
# Orchard CLI wrapper.
# Dispatches shell arguments through release `eval` into OrchardCLI.main/1.
# This is necessary because the release binary only understands OTP commands
# (start, stop, eval, etc.), not application-level CLI commands (tls, models, etc.).

ORCHARD_ROOT="/Library/Application Support/Orchard"
ENV_FILE="$ORCHARD_ROOT/config/controller.env"
ORCHARD_CLI="$ORCHARD_ROOT/releases/orchard_cli/bin/orchard_cli"

# Source controller env for DB-backed CLI commands such as upgrade preflight.
# Env files must be root-owned with no group/world permissions (e.g. 0600).
if [ -f "$ENV_FILE" ]; then
    _env_meta=$(stat -f '%u:%Lp' "$ENV_FILE" 2>/dev/null) || _env_meta=""
    _env_uid=${_env_meta%%:*}
    _env_mode=${_env_meta#*:}
    if [ -z "$_env_meta" ]; then
        printf 'orchardctl: WARNING: could not inspect env file %s; skipping overrides\n' "$ENV_FILE" >&2
    elif [ "$_env_uid" != "0" ]; then
        printf 'orchardctl: WARNING: ignoring env file %s (owner uid=%s, expected 0); skipping overrides\n' "$ENV_FILE" "$_env_uid" >&2
    elif [ "${_env_mode#?}" != "00" ]; then
        printf 'orchardctl: WARNING: ignoring env file %s (mode=%s, group/world bits set); skipping overrides\n' "$ENV_FILE" "$_env_mode" >&2
    elif [ ! -r "$ENV_FILE" ]; then
        printf 'orchardctl: WARNING: env file %s is not readable by this user; skipping overrides\n' "$ENV_FILE" >&2
    else
        set -a
        . "$ENV_FILE"
        set +a
    fi
fi

# Build an Elixir string-list literal from shell argv.
# Escapes backslashes, double quotes, hash (prevents #{} interpolation), and tabs.
args=""
for arg in "$@"; do
  # Escape \ first (before introducing new backslashes), then ", #, control chars
  escaped=$(printf '%s' "$arg" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/#/\\#/g' -e 's/	/\\t/g')
  if [ -n "$args" ]; then
    args="$args, \"$escaped\""
  else
    args="\"$escaped\""
  fi
done

exec "$ORCHARD_CLI" eval "OrchardCLI.main([$args])"
