#!/bin/sh
set -eu
# Orchard node-agent wrapper.
# Loads optional env overrides from config dir before starting the release.

ORCHARD_ROOT="/Library/Application Support/Orchard"
ENV_FILE="$ORCHARD_ROOT/config/node-agent.env"

if [ -f "$ENV_FILE" ]; then
    set -a
    . "$ENV_FILE"
    set +a
fi

exec "$ORCHARD_ROOT/releases/orchard_node_agent/bin/orchard_node_agent" "$@"
