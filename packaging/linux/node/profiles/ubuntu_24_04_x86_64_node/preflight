#!/bin/sh
set -eu

fail() {
    printf 'orchard-linux-node-preflight: %s\n' "$1" >&2
    exit 1
}

root=${1:-/}
case "$root" in /*) ;; *) root=/ ;; esac
os_release="$root/etc/os-release"
[ -f "$os_release" ] || fail "missing $os_release"

id_fields=$(grep -c '^ID=' "$os_release" || true)
version_fields=$(grep -c '^VERSION_ID=' "$os_release" || true)
[ "$id_fields" = "1" ] && grep -Fqx 'ID=ubuntu' "$os_release" || fail "requires exact ID=ubuntu"
[ "$version_fields" = "1" ] && grep -Fqx 'VERSION_ID="24.04"' "$os_release" || fail "requires exact VERSION_ID=24.04"

[ "$(uname -m)" = "x86_64" ] || fail "requires x86_64"
[ "$(cat "$root/proc/1/comm")" = "systemd" ] || fail "requires systemd as PID 1"
! grep -qi microsoft "$root/proc/sys/kernel/osrelease" || fail "WSL is not qualified"
! systemd-detect-virt --container --quiet || fail "containers as hosts are not qualified"
dpkg --compare-versions "$(uname -r | sed 's/-.*//')" ge 6.8 || fail "requires Linux kernel 6.8 or newer"
dpkg --compare-versions "$(ldd --version | sed -n '1s/.* //p')" ge 2.39 || fail "requires glibc 2.39 or newer"
dpkg --compare-versions "$(systemctl --version | sed -n '1s/[^0-9]*\([0-9][0-9]*\).*/\1/p')" ge 255 || fail "requires systemd 255 or newer"
command -v stat >/dev/null 2>&1 && stat --version | grep -q 'GNU coreutils' || fail "requires GNU coreutils stat"
command -v timeout >/dev/null 2>&1 && timeout --version | grep -q 'GNU coreutils' || fail "requires GNU coreutils timeout"
[ "$(stat -fc %T "$root/sys/fs/cgroup")" = "cgroup2fs" ] || fail "requires unified cgroup v2"
command -v flock >/dev/null 2>&1 || fail "requires util-linux flock"
while read -r package minimum; do
    installed=$(dpkg-query -W -f='${Version}' "$package" 2>/dev/null) || fail "missing dependency $package"
    dpkg --compare-versions "$installed" ge "$minimum" || fail "$package $installed does not satisfy >= $minimum"
done <<'EOF'
libc6 2.39
systemd 255
util-linux 2.39
coreutils 9.4
adduser 3.137ubuntu1
libssl3t64 3.0.13
libtinfo6 6.4
zlib1g 1:1.3.dfsg
libstdc++6 14
libgcc-s1 14
EOF

printf 'orchard-linux-node-preflight: compatible ubuntu_24_04_x86_64_node candidate host\n'
